# ============================================================
#  TEBEX — Headless API
# ============================================================
# Token público de tu tienda (Creator Panel > Developers > API Keys).
# Sin este valor la web arranca en MODO DEMO con un catálogo de ejemplo.
TEBEX_PUBLIC_TOKEN=tu_token_publico

# Token público para el navegador. Se usa solo para crear el carrito desde el
# cliente y que Tebex reciba la IP real del comprador. No es una clave secreta.
# Puedes usar el mismo valor que TEBEX_PUBLIC_TOKEN.
NEXT_PUBLIC_TEBEX_PUBLIC_TOKEN=tu_token_publico

# Clave privada. SOLO se usa en el servidor, nunca en el navegador.
# NUNCA la pongas en variables NEXT_PUBLIC_* ni la subas al repositorio.
# Rellénala en .env.local (desarrollo) o en las variables del hosting.
TEBEX_PRIVATE_KEY=tu_clave_privada

# ============================================================
#  MARCA / CONTENIDO EDITABLE
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=VayluxMC Store
NEXT_PUBLIC_STORE_TAGLINE=La tienda oficial de VayluxMC Network
NEXT_PUBLIC_SERVER_NAME=VayluxMC Network
NEXT_PUBLIC_SERVER_IP=play.vayluxmc.net
NEXT_PUBLIC_SERVER_BEDROCK_IP=play.vayluxmc.net
NEXT_PUBLIC_SERVER_BEDROCK_PORT=19132
NEXT_PUBLIC_SERVER_VERSION=Java 1.8 - 1.21 · Bedrock
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@vayluxmc.net
